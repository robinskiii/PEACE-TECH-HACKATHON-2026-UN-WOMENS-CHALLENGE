{
  "manifest_version": 3,
  "name": "Reality Check",
  "version": "2.0.0",
  "description": "Highlights hate speech or gendered disinformation aimed at women leaders on any website.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "file://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reality Check"
  }
}
